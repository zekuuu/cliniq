}
subgraph cluster_7 { label="InventoryTracker"; style="rounded,filled"; color="#9ca3af"; fillcolor="#fafafa"; fontsize=13;
  inventory_items [fillcolor="#e4f0d0", style="rounded,filled"];
  inventory_item_allergy_words [fillcolor="#e4f0d0", style="rounded,filled"];
