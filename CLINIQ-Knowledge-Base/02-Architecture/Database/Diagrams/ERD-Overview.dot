}
subgraph cluster_6 { label="EmergencyResponse"; style="rounded,filled"; color="#9ca3af"; fillcolor="#fafafa"; fontsize=13;
  incidents [fillcolor="#fbd9d9", style="rounded,filled"];
  incident_vital_readings [fillcolor="#fbd9d9", style="rounded,filled"];
