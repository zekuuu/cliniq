digraph ERD {
rankdir=LR; compound=true; fontname="Helvetica"; nodesep=0.35; ranksep=1.3; splines=true;
node [shape=box,style="rounded,filled",fontname="Helvetica",fontsize=11,margin="0.12,0.06"];
edge [fontname="Helvetica",fontsize=8,color="#6b7280",arrowsize=0.7];
labelloc=t; fontsize=18; label="CLINIQ database: all 44 tables (PROPOSED v1, NOT FINAL)\nclusters = owning backend module; dashed box = Spec table (not in the frontend contract yet); arrow = foreign key, pointing at the parent; same patient = composite key that forces the record and its parent to be for the same patient\n";
subgraph cluster_0 { label="UserManagement"; style="rounded,filled"; color="#9ca3af"; fillcolor="#fafafa"; fontsize=13;
  users [fillcolor="#e8e3fb", style="rounded,filled"];
  password_histories [fillcolor="#e8e3fb", style="rounded,filled"];
}
subgraph cluster_1 { label="Shared"; style="rounded,filled"; color="#9ca3af"; fillcolor="#fafafa"; fontsize=13;
  system_settings [fillcolor="#eceff1", style="rounded,filled"];
  number_sequences [fillcolor="#eceff1", style="rounded,filled"];
  grade_levels [fillcolor="#eceff1", style="rounded,filled"];
  follow_ups [fillcolor="#eceff1", style="rounded,filled"];
  issue_reports [fillcolor="#eceff1", style="rounded,filled"];
  audit_logs [fillcolor="#eceff1", style="rounded,filled"];
}
subgraph cluster_2 { label="FirstAidChecklist"; style="rounded,filled"; color="#9ca3af"; fillcolor="#fafafa"; fontsize=13;
  complaint_types [fillcolor="#fde9d9", style="rounded,filled"];
  triage_steps [fillcolor="#fde9d9", style="rounded,filled"];
  triage_checks [fillcolor="#fde9d9", style="rounded,filled,dashed"];
}
subgraph cluster_3 { label="StudentRecords"; style="rounded,filled"; color="#9ca3af"; fillcolor="#fafafa"; fontsize=13;
  student_import_batches [fillcolor="#dcefe3", style="rounded,filled"];
  students [fillcolor="#dcefe3", style="rounded,filled"];
  student_health_entries [fillcolor="#dcefe3", style="rounded,filled"];
  emergency_contacts [fillcolor="#dcefe3", style="rounded,filled"];
  emergency_contact_verifications [fillcolor="#dcefe3", style="rounded,filled,dashed"];
  student_record_reviews [fillcolor="#dcefe3", style="rounded,filled"];
}
subgraph cluster_11 { label="StaffPatients"; style="rounded,filled"; color="#9ca3af"; fillcolor="#fafafa"; fontsize=13;
  personnel [fillcolor="#dcefe3", style="rounded,filled"];
  personnel_health_entries [fillcolor="#dcefe3", style="rounded,filled"];
  personnel_emergency_contacts [fillcolor="#dcefe3", style="rounded,filled"];
}
subgraph cluster_5 { label="ClinicVisits"; style="rounded,filled"; color="#9ca3af"; fillcolor="#fafafa"; fontsize=13;
  visits [fillcolor="#fff3c4", style="rounded,filled"];
  visit_extra_complaints [fillcolor="#fff3c4", style="rounded,filled"];
  excuse_letters [fillcolor="#fff3c4", style="rounded,filled"];
