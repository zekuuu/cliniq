# CLINIQ backend. Copy to .env and run: php artisan key:generate
# No real secret belongs here. APP_KEY and .env are never committed.

APP_NAME=CLINIQ
APP_ENV=local
APP_KEY=
# Production: APP_ENV=production and APP_DEBUG=false.
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# XAMPP MariaDB, with the dedicated account of Environment-Setup.md, never root.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cliniq
DB_USERNAME=cliniq_app
DB_PASSWORD=

# File drivers need no table.
SESSION_DRIVER=file
# 7 days in minutes. It renews on each request; FixedSessionLifetime enforces 7 days from sign-in (ADR-057).
SESSION_LIFETIME=10080
SESSION_PATH=/
SESSION_DOMAIN=localhost
# Set to true once the LAN has HTTPS (ADR-057).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Comma-separated, explicit origins only; a wildcard is dropped. A deployment adds the clinic
# computer's LAN address, and matches it in the stateful domains and the session domain.
CORS_ALLOWED_ORIGINS=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# Idle minutes before the Admin is signed out (ADR-048).
CLINIQ_ADMIN_IDLE_MINUTES=30

LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

BCRYPT_ROUNDS=12
MAIL_MAILER=log
